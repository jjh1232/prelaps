---
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import type { Locale } from '../i18n/config';
import {
  absoluteUrl,
  hreflangLinks,
  localizePath,
  useTranslations,
} from '../i18n/utils';

interface Props {
  /** 이 페이지의 언어. <html lang> 과 번역 조회에 함께 쓰인다. */
  lang: Locale;
  /** 언어를 뺀 경로. '' = 홈, '/about' = 소개. canonical/hreflang 계산의 기준. */
  path?: string;
  /** 언어마다 반드시 달라야 한다. 영어로 통일하면 중복 페이지로 판정된다. */
  title: string;
  description: string;
  /**
   * 색인 대상이 아닌 페이지(404 등)는 true.
   * canonical / hreflang 을 아예 내보내지 않는다 — 실재하지 않는 주소를
   * 자기 자신이라고 선언하면 오히려 잘못된 신호가 된다.
   */
  noindex?: boolean;
}

const { lang, path = '', title, description, noindex = false } = Astro.props;

/**
 * 애드센스 퍼블리셔 ID (`ca-pub-…`). **발급 전에는 빈 문자열로 둔다** —
 * 비어 있으면 아래에서 스크립트를 아예 내보내지 않는다. 플레이스홀더를 그대로
 * 올리면 남의 client 로 광고 요청이 나가고, 하필 그 상태가 심사에 걸린다.
 *
 * ⚠ 같은 값을 채울 곳이 다섯 군데다. 여기(허브 15장)와 도구 Worker 넷 —
 *   breakkorean/src/index.js, imageSquish/worker/index.js,
 *   rulletMvp/worker/index.js, vfile/worker/index.js 의 `ADSENSE_ID`.
 *   여기만 채우면 심사 대상 페이지의 과반인 도구 24장이 통째로 빠진다.
 *   Astro 레이아웃 하나가 사이트 전체를 덮는다는 말은 이 사이트에서는 틀리다.
 */
const ADSENSE_ID = 'ca-pub-3724742785414572';

const t = useTranslations(lang);
const canonical = absoluteUrl(localizePath(lang, path)); // canonical 은 항상 자기 자신
const alternates = noindex ? [] : hreflangLinks(path);
const year = new Date().getFullYear();

const nav = [
  { path: '', label: t('nav.home') },
  // 읽을 거리를 소개보다 앞에 둔다. 도구 안에만 있을 때는 존재 자체가 안 보였다.
  { path: '/guides', label: t('nav.guides') },
  { path: '/about', label: t('nav.about') },
];

// 푸터의 정책 링크. 애드센스가 요구하는 필수 페이지(privacy/about/contact)로 가는
// 유일한 통로이므로, 모든 페이지에서 보여야 한다 (docs §9).
// 도구 쪽 페이지들은 자기 푸터에서 /{lang}/privacy#<도구> 앵커로 여기를 가리킨다.
const footerNav = [
  { path: '/about', label: t('nav.about') },
  { path: '/privacy', label: t('nav.privacy') },
  { path: '/terms', label: t('nav.terms') },
  { path: '/contact', label: t('nav.contact') },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      Google tag (gtag.js) — 이 레이아웃을 쓰는 모든 페이지에 한 번에 적용된다.
      404 도 이 레이아웃을 쓴다. 페이지마다 붙이면 새 페이지에서 조용히 빠진다.

      is:inline 은 필수다. 빼면 Astro 가 번들로 끌어가 실행 시점이 바뀐다.
    -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-NQ5XY9JPJ4"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());

      gtag('config', 'G-NQ5XY9JPJ4');
    </script>
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>{title}</title>
    <meta name="description" content={description} />

    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {
      alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:locale" content={lang} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}

    {/*
      애드센스. 위 ADSENSE_ID 에 값이 들어가는 순간 이 레이아웃을 쓰는 모든 페이지에
      한 번에 붙는다 (docs §9). is:inline 은 GA 와 같은 이유로 필수다 —
      빼면 Astro 가 번들로 끌어가 실행 시점이 바뀐다.
    */}
    {
      ADSENSE_ID ? (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_ID}`}
          crossorigin="anonymous"
        />
      ) : null
    }
  </head>

  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={localizePath(lang, '')}>{t('site.name')}</a>
        <nav class="site-nav">
          {
            nav.map((item) => (
              <a
                href={localizePath(lang, item.path)}
                aria-current={item.path === path ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <span class="spacer"></span>
        <LanguageSwitcher lang={lang} path={path} />
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <nav class="footer-nav">
          {
            footerNav.map((item) => (
              <a href={localizePath(lang, item.path)}>{item.label}</a>
            ))
          }
        </nav>
        &copy; {year} {t('site.name')}. {t('footer.rights')}
      </div>
    </footer>
  </body>
</html>
