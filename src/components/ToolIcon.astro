---
/**
 * 홈 타일의 도구 아이콘. 선 하나짜리 24×24 그림이고 색은 currentColor 다 —
 * 도구마다 다른 색은 global.css 의 `.tile[data-tool=…]` 가 정한다.
 * 도구를 추가할 때 여기 한 항목을 더한다. 없으면 빈 칸으로 나간다.
 */
interface Props {
  id: string;
}

const { id } = Astro.props;

const ICONS: Record<string, string> = {
  // 글자 T 와 한글 획, 아래 점선 — 「글자가 어긋났다」
  mojibake:
    '<path d="M4 7h7M7.5 7v10"/><path d="M14 9c1.5-2 5-2 5 1s-5 2.5-5 5h5"/><path d="M3 20h18" stroke-dasharray="2 2"/>',
  // 사진 틀 안에서 안팎으로 당기는 화살표
  imagesquish:
    '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M14 10l5-5M15 5h4v4"/><path d="M10 14l-5 5M5 15v4h4"/>',
  // 모서리 접힌 문서
  doceditor:
    '<path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8z"/><path d="M14 3v5h5"/><path d="M8 13h8M8 17h5"/>',
  // 세로 틀 안의 상반신
  idphoto:
    '<rect x="5" y="3" width="14" height="18" rx="1.5"/><circle cx="12" cy="10" r="3"/><path d="M7.5 18c1-2.5 2.6-3.5 4.5-3.5s3.5 1 4.5 3.5"/>',
  // 펼친 책
  imageviewer:
    '<path d="M2 5h8a2 2 0 0 1 2 2v13a2 2 0 0 0-2-2H2z"/><path d="M22 5h-8a2 2 0 0 0-2 2v13a2 2 0 0 1 2-2h8z"/>',
  // 신분증에 검은 칠 한 줄
  imageblur:
    '<rect x="2" y="5" width="20" height="14" rx="2"/><circle cx="7.5" cy="11" r="2"/><rect x="12" y="9" width="7" height="3" fill="currentColor"/><path d="M12 15h5"/>',
  // 결승 깃발
  race: '<path d="M5 21V4"/><path d="M5 4h12l-2.5 4L17 12H5"/>',
  // 폴더
  vfile: '<path d="M3 6a1 1 0 0 1 1-1h5l2 2h9a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/>',
};
---

<svg
  width="28"
  height="28"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={ICONS[id] ?? ''}
/>
