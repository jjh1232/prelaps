---
import Base from '../../layouts/Base.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import { byCategory } from '../../data/tools';
import type { Locale } from '../../i18n/config';
import { localeStaticPaths, useTranslations, type TranslationKey } from '../../i18n/utils';

// 이 한 줄이 /ko, /en, /ja 세 장의 정적 HTML 을 만든다.
export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);
---

<Base
  lang={lang}
  path=""
  title={t('home.title')}
  description={t('home.description')}
>
  {/* 제목은 화면에서 뺐다(2026-11-09 사용자 결정). 스크린리더와 검색엔진이 읽을 h1 하나는 남긴다. */}
  <h1 class="visually-hidden">{t('home.heading')}</h1>

  {/*
    홈은 아이콘 + 이름 타일뿐이다(2026-11-09 사용자 결정, tools.pdf24.org 의 짜임).
    설명 줄·증상으로 찾기·읽을 거리 카드·FAQ 를 뺐다 — 쓰는 사람은 읽지 않는다.
    설명은 title 툴팁으로만 남긴다. 글은 상단 메뉴의 /guides 로 간다. 되살릴 때는 git 이력에서.
  */}
  {
    byCategory().map((group) => (
      <>
        <h2 class="section-title">{t(`home.cat.${group.category}` as TranslationKey)}</h2>
        <ul class="tile-grid">
          {group.tools.map((tool) => (
            <li>
              <a class="tile" data-tool={tool.id} href={tool.href(lang)} title={t(tool.descKey)}>
                <span class="tile-icon"><ToolIcon id={tool.id} /></span>
                <span class="tile-name">{t(tool.nameKey)}</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    ))
  }

  <ul class="home-facts">
    <li>{t('home.facts.local')}</li>
    <li>{t('home.facts.signup')}</li>
    <li>{t('home.facts.free')}</li>
  </ul>
</Base>
