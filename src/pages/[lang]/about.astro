---
import Base from '../../layouts/Base.astro';
import type { Locale } from '../../i18n/config';
import { localeStaticPaths, localizePath, useTranslations } from '../../i18n/utils';

/**
 * 애드센스 심사에서 사람이 실제로 읽는 페이지다 (docs §9).
 * "누가 만드는가 · 왜 만들었는가 · 데이터를 어떻게 다루는가 · 어떻게 연락하는가"
 * 네 가지가 다 있어야 한다. 두 문장짜리 소개는 저품질로 잡힌다.
 *
 * 문구는 전부 locales/*.json 에 있다. 한 언어만 고치면 나머지 둘이 조용히 어긋나므로,
 * 여기에 하드코딩된 문장을 넣지 말 것.
 */
export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);
---

<Base
  lang={lang}
  path="/about"
  title={t('about.title')}
  description={t('about.description')}
>
  <div class="doc">
    <h1>{t('about.heading')}</h1>
    <p class="lede">{t('about.lede')}</p>

    <h2>{t('about.who.h')}</h2>
    <p>{t('about.who.p')}</p>

    <h2>{t('about.why.h')}</h2>
    <p>{t('about.why.p1')}</p>
    <p>{t('about.why.p2')}</p>

    <h2>{t('about.local.h')}</h2>
    <p>{t('about.local.p1')}</p>
    <p>{t('about.local.p2')}</p>

    <h2>{t('about.pick.h')}</h2>
    <p>{t('about.pick.p')}</p>

    <h2>{t('about.ads.h')}</h2>
    <p>{t('about.ads.p1')}</p>
    <p>
      {t('about.ads.p2')}{' '}
      <a href={localizePath(lang, '/privacy')}>{t('about.privacyLink')}</a>
    </p>

    <h2>{t('about.contact.h')}</h2>
    <p>
      {t('about.contact.p')}{' '}
      <a href={localizePath(lang, '/contact')}>{t('about.contactLink')}</a>
    </p>
  </div>
</Base>
