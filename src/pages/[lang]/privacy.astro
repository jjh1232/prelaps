---
import Base from '../../layouts/Base.astro';
import type { Locale } from '../../i18n/config';
import { localeStaticPaths, useTranslations } from '../../i18n/utils';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Locale };
const t = useTranslations(lang);

const email = t('site.email');

/**
 * §3 「서비스별 안내」. 도구가 늘면 여기 한 줄만 추가한다 (docs §8).
 * id 는 도구 푸터가 /{lang}/privacy#<id> 앵커로 가리키는 값이라 슬러그와 같아야 한다.
 * 네 항목이 전부 「없음」인 것이 정상이다 — 이 사이트에는 입력을 받는 서버가 없다.
 */
const tools = [
  { id: 'mojibake', name: t('tools.mojibake.name'), note: t('privacy.tool.mojibake.note') },
  { id: 'imagesquish', name: t('tools.imagesquish.name'), note: t('privacy.tool.imagesquish.note') },
  { id: 'doceditor', name: t('tools.doceditor.name'), note: t('privacy.tool.doceditor.note') },
  { id: 'idphoto', name: t('tools.idphoto.name'), note: t('privacy.tool.idphoto.note') },
  { id: 'race', name: t('privacy.tool.race.name'), note: t('privacy.tool.race.note') },
  // 다른 것들과 달리 브라우저에서 돌지 않는다. 여기는 안내와 링크만 있고
  // 프로그램은 방문자 PC 에서 도므로, 「없음」의 이유가 다른 항목과 다르다.
  { id: 'vfile', name: t('tools.vfile.name'), note: t('privacy.tool.vfile.note') },
];
---

<Base
  lang={lang}
  path="/privacy"
  title={t('privacy.title')}
  description={t('privacy.description')}
>
  <div class="doc">
    <h1>{t('privacy.heading')}</h1>
    <p class="lede">{t('privacy.intro')}</p>
    <p class="updated">{t('common.updated')}: {t('site.updatedAt')}</p>

    <h2>{t('privacy.s1.h')}</h2>
    <p>{t('privacy.s1.p1')}</p>
    <p>{t('privacy.s1.p2')}</p>
    <p>{t('privacy.s1.p3')}</p>

    <h2>{t('privacy.s2.h')}</h2>

    {/*
      방문 통계가 광고보다 먼저 온다 — 지금 실제로 돌고 있는 것이 이쪽이기 때문이다.
      GA 스니펫은 허브가 Base.astro 에서, 도구는 각 Worker 가 </head> 앞에 끼운다.
      계측을 끄거나 켤 때 이 절을 같이 고치지 않으면 방침이 곧바로 거짓말이 된다.
    */}
    <h3>{t('privacy.analytics.h')}</h3>
    <p>{t('privacy.analytics.p1')}</p>
    <p>{t('privacy.analytics.p2')}</p>
    <p>{t('privacy.analytics.p3')}</p>
    <ul>
      <li>
        <a href="https://tools.google.com/dlpage/gaoptout" rel="noopener">
          {t('privacy.analytics.link.optOut')}
        </a>
      </li>
      <li>
        <a href="https://policies.google.com/technologies/partner-sites" rel="noopener">
          {t('privacy.analytics.link.partner')}
        </a>
      </li>
    </ul>

    {/*
      애드센스가 요구하는 고지 세 가지: 제3자(구글 포함)의 쿠키 사용, 이전 방문 기록
      기반 광고, 사용자가 끌 수 있는 경로. 링크는 문장 안에 끼우지 않고 목록으로 뺐다 —
      문장에 끼우면 언어마다 어순이 달라 조각을 이어 붙이게 되고, 세 언어가 어긋난다.
    */}
    <h3>{t('privacy.ads.h')}</h3>
    <p>{t('privacy.ads.p1')}</p>
    <p>{t('privacy.ads.p2')}</p>
    <p>{t('privacy.ads.p3')}</p>
    <ul>
      <li>
        <a href="https://www.google.com/settings/ads" rel="noopener">
          {t('privacy.ads.link.optOut')}
        </a>
      </li>
      <li>
        <a href="https://www.aboutads.info/choices/" rel="noopener">
          {t('privacy.ads.link.aboutAds')}
        </a>
      </li>
      <li>
        <a href="https://policies.google.com/technologies/ads" rel="noopener">
          {t('privacy.ads.link.policy')}
        </a>
      </li>
    </ul>

    <h3>{t('privacy.fonts.h')}</h3>
    <p>{t('privacy.fonts.p')}</p>

    <h3>{t('privacy.logs.h')}</h3>
    <p>{t('privacy.logs.p')}</p>

    <h3>{t('privacy.children.h')}</h3>
    <p>{t('privacy.children.p')}</p>

    <h3>{t('privacy.rights.h')}</h3>
    <p>{t('privacy.rights.p')}</p>

    <h3>{t('privacy.contact.h')}</h3>
    <p>{t('privacy.contact.p')} <a href={`mailto:${email}`}>{email}</a></p>

    <h3>{t('privacy.changes.h')}</h3>
    <p>{t('privacy.changes.p')}</p>

    <h2>{t('privacy.s3.h')}</h2>
    <p>{t('privacy.s3.intro')}</p>

    {
      tools.map((tool) => (
        <section class="tool-block" id={tool.id}>
          <h3>{tool.name}</h3>
          <dl>
            <dt>{t('privacy.f.collect')}</dt>
            <dd>{t('privacy.none')}</dd>
            <dt>{t('privacy.f.purpose')}</dt>
            <dd>{t('privacy.none')}</dd>
            <dt>{t('privacy.f.retention')}</dt>
            <dd>{t('privacy.none')}</dd>
            <dt>{t('privacy.f.third')}</dt>
            <dd>{t('privacy.none')}</dd>
          </dl>
          <p class="note">{tool.note}</p>
        </section>
      ))
    }

    <h2>{t('privacy.s4.h')}</h2>
    <p>{t('site.updatedAt')}</p>
  </div>
</Base>
